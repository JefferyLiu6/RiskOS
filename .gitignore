# ---------------------------------------------------------------------------
# Data: NEVER commit raw or derived loan-level data.
# Freddie Mac SFLLD licence terms permit personal/internal analytical use only;
# redistribution requires a licence. The entire data/ tree is untracked.
# ---------------------------------------------------------------------------
data/
# data/ may be a symlink to external storage (see README); the bare
# pattern above only matches a real directory, so ignore the link too.
/data
# Derived loan-level observations written alongside the figures. Aggregate CSVs
# and PNGs under reports/figures are fine to commit; a per-loan parquet is not.
/reports/figures/*.parquet

# Secrets
.env
.env.*
!.env.example

# Fitted model artifacts (regenerated by `make train`).
# ANCHORED to the repo root with a leading slash. Written as a bare `models/`
# this also matches src/riskos/models/, which silently kept the entire
# modelling package - scorecard, challenger, hazard, calibration, selection -
# out of version control. See finding R-013.
/models/

# MLflow local backend
/mlruns/
mlflow.db

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Quarto
/.quarto/
reports/*.pdf
reports/*_files/

# OS
.DS_Store

# Local, machine-specific tool permissions
.claude/settings.local.json

# Personal interview preparation. Anchored to the root; never committed.
/interview/

# Coverage data
.coverage
